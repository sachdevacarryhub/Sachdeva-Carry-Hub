# ---------------------------------------------------------------
# Sachdeva Carry Hub — environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local.
# ---------------------------------------------------------------

# Supabase (Project Settings -> API)
# Public values: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" key or the newer "publishable" key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used only by `npm run admin:create` (scripts/create-admin.mjs) to
# create the first admin user. The running website does not need it.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Dashboard -> API Keys). SERVER ONLY:
# all uploads are signed on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public base URL of the website, without a trailing slash.
# Used for canonical URLs, sitemap and QR codes.
# Example: https://sachdevacarryhub.in   (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
